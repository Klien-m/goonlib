{
  "hidden": true,
  "summary": "Both Apple Silicon and Intel, as electron-builder.yml asks for. Set GOONLIB_MACOS_TAGS once mac nodes are connected.",
  "runner": {
    "tags": [
      "cnb:arch:amd64"
    ],
    "cpus": 16
  },
  "pipeline": {
    "name": "release-macos",
    "docker": {
      "image": "node:22"
    },
    "env": {
      "CSC_IDENTITY_AUTO_DISCOVERY": "false"
    },
    "stages": [
      {
        "name": "build",
        "script": "npm ci\nnpm run dist -- --publish never --mac"
      },
      {
        "name": "publish",
        "type": "cnb:apply",
        "options": {
          "event": "api_trigger_publish"
        }
      }
    ],
    "endStages": [
      {
        "name": "attach",
        "script": "node .cnb/tools/release.js release\nnode .cnb/tools/release.js upload"
      },
      {
        "name": "mark",
        "type": "cnb:resolve",
        "options": {
          "key": "release-macos"
        }
      }
    ]
  }
}
