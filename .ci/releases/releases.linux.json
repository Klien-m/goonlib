{
  "hidden": true,
  "summary": "An AppImage, which needs nothing signed to run.",
  "pipeline": {
    "name": "release-linux",
    "docker": {
      "image": "node:22"
    },
    "env": {
      "CSC_IDENTITY_AUTO_DISCOVERY": "false"
    },
    "stages": [
      {
        "name": "build",
        "script": "npm ci\nnpm run dist -- --publish never --linux"
      },
      {
        "name": "publish",
        "type": "cnb:apply",
        "options": {
          "event": "api_trigger_publish"
        }
      }
    ],
    "endStages": [
      {
        "name": "attach",
        "script": "node .cnb/tools/release.js release\nnode .cnb/tools/release.js upload"
      },
      {
        "name": "mark",
        "type": "cnb:resolve",
        "options": {
          "key": "release-linux"
        }
      }
    ]
  }
}
